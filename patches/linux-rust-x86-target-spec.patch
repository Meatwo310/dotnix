From: Miguel Ojeda <ojeda@kernel.org>
Subject: [PATCH] rust: x86: support Rust >= 1.98.0 target spec

Starting with Rust 1.98.0, the target spec no longer supports
`x86-softfloat`. Use `softfloat` for newer compilers while preserving
the existing target spec for older compilers.

Upstream: https://github.com/torvalds/linux/commit/905b06d32a52afe32fcf5f30cf298c9ea6359f11
Signed-off-by: Miguel Ojeda <ojeda@kernel.org>

diff --git a/scripts/generate_rust_target.rs b/scripts/generate_rust_target.rs
--- a/scripts/generate_rust_target.rs
+++ b/scripts/generate_rust_target.rs
@@ -196,7 +196,9 @@ fn main() {
         }
     } else if cfg.has("X86_64") {
         ts.push("arch", "x86_64");
-        if cfg.rustc_version_atleast(1, 86, 0) {
+        if cfg.rustc_version_atleast(1, 98, 0) {
+            ts.push("rustc-abi", "softfloat");
+        } else if cfg.rustc_version_atleast(1, 86, 0) {
             ts.push("rustc-abi", "x86-softfloat");
         }
         ts.push(
@@ -236,7 +238,9 @@ fn main() {
             panic!("32-bit x86 only works under UML");
         }
         ts.push("arch", "x86");
-        if cfg.rustc_version_atleast(1, 86, 0) {
+        if cfg.rustc_version_atleast(1, 98, 0) {
+            ts.push("rustc-abi", "softfloat");
+        } else if cfg.rustc_version_atleast(1, 86, 0) {
             ts.push("rustc-abi", "x86-softfloat");
         }
         ts.push(
